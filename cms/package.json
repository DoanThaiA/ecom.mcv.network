{
  "name": "cchat-cms",
  "author": "cchat.io",
  "version": "1.0.81",
  "private": true,
  "scripts": {
    "dev": "vite --force",
    "start": "vite preview",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "yarn rm:all && yarn install && yarn dev",
    "re:build": "yarn rm:all && yarn install && yarn build",
    "re:build-npm": "npm run rm:all && npm install && npm run build",
    "dev:host": "vite --host",
    "sync-locale": "node -e \"require('./locale-tool/localizationFromExcel.js').convertLocalizeFromExcel()\"",
    "proto:gen": "bash scripts/generate-proto.sh"
  },
