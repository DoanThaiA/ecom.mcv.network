NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang

WEBSITE_DOMAIN=http://localhost:3001
CMS_DOMAIN=http://localhost:3002
BACKEND_DOMAIN=http://localhost:3000

# MongoDB connection URL
MONGODB_URL=mongodb://mongo:27017/api

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_CLIENT_PORT=1080

# eSMS Configuration
ESMS_API_KEY=your_esms_api_key
ESMS_SECRET_KEY=your_esms_secret_key

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ZALO_APP_ID=
ZALO_APP_SECRET=

NHANH_APP_ID=
NHANH_APP_SECRET=
NHANH_OAUTH_URL=https://nhanh.vn/oauth
NHANH_API_URL=https://pos.open.nhanh.vn

WORKER_HOST=redis://redis:6379/1

# Cache configuration (falls back to in-memory if not available)
REDIS_URL=redis://redis:6379
CACHE_TTL=300000

# CDP Configuration
CDP_PHONE=your_cdp_phone
CDP_PASSWORD=your_cdp_password

VN_PROXY_URL=http://localhost:8080

