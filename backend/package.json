    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.6",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.4",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/mongoose": "^5.11.96",
    "@types/mongoose-paginate-v2": "^1.6.4",
    "@types/ms": "2.1.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.3",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "^16.0.0",
    "jest": "30.1.3",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "3.6.2",
    "prompts": "2.4.2",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "ts-proto": "^2.8.3",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/",
      "main.ts",
      "app.module.ts",
      "\\.schema\\.ts$",
      "\\.pb\\.ts$",
      "_pb\\.js$",
      "/auth-facebook/",
      "/auth-google/",
      "/auth-apple/",
      "/sms/",
      "/zalo/",
      "/nhanh/",
      "/cdp/"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
