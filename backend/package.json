{
  "name": "cchat-ecommerce-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "seed:run": "ts-node -r tsconfig-paths/register ./src/database/seeds/run-seed.ts",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:server": "nest build server",
    "build:worker": "nest build worker",
    "build:all": "nest build server && nest build worker",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"worker/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node worker/dist/worker/src/main",
    "lint": "eslint \"{src,apps,libs,test,worker}/**/*.ts\"",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPatterns=\"service.spec\" --runInBand",
    "test:repo": "jest --testPathPatterns=\"repository.spec\" --runInBand",
    "test:integration": "jest --testPathPatterns=\"integration.spec\" --runInBand --forceExit"
  },
