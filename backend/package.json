    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.10",
    "@types/google-protobuf": "^3.15.12",
    "@types/multer-s3": "3.0.3",
    "@types/uuid": "^10.0.0",
    "apple-signin-auth": "2.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "3.0.2",
    "bullmq": "^5.65.0",
    "cache-manager": "^7.2.4",
